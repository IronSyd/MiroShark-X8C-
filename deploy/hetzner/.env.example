# Copy this file to deploy/hetzner/.env on the Hetzner server.
# Do not commit deploy/hetzner/.env.

# Public IP-only deployment URL.
PUBLIC_BASE_URL=http://YOUR_HETZNER_IP

# Shared Basic Auth credentials.
# Generate the hash on the server:
# docker run --rm caddy:2.8-alpine caddy hash-password --plaintext 'replace-with-strong-password'
BASIC_AUTH_USER=miroshark
BASIC_AUTH_HASH='$2a$14$replace-with-caddy-bcrypt-hash'

# Core application secrets.
SECRET_KEY=replace-with-random-secret
MIROSHARK_ADMIN_TOKEN=replace-with-random-admin-token
MIROSHARK_INTERNAL_KEY=replace-with-random-internal-proxy-key
NEO4J_PASSWORD=replace-with-strong-neo4j-password
FLASK_DEBUG=false
ENABLE_SITEMAP=false

# App-native Cloud preset through OpenRouter.
LLM_PROVIDER=openai
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL_NAME=xiaomi/mimo-v2-flash
LLM_API_KEY=sk-or-v1-replace-me

SMART_PROVIDER=openai
SMART_BASE_URL=https://openrouter.ai/api/v1
SMART_MODEL_NAME=google/gemini-3-flash-preview
SMART_API_KEY=sk-or-v1-replace-me

NER_BASE_URL=https://openrouter.ai/api/v1
NER_MODEL_NAME=google/gemini-3-flash-preview
NER_API_KEY=sk-or-v1-replace-me

WONDERWALL_BASE_URL=https://openrouter.ai/api/v1
WONDERWALL_MODEL_NAME=xiaomi/mimo-v2-flash
WONDERWALL_API_KEY=sk-or-v1-replace-me

OPENAI_API_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=sk-or-v1-replace-me

EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=openai/text-embedding-3-large
EMBEDDING_BASE_URL=https://openrouter.ai/api
EMBEDDING_DIMENSIONS=768
EMBEDDING_API_KEY=sk-or-v1-replace-me

# Optional integrations. Leave blank unless configured.
WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
